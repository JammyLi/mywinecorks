PORT=3600
# The Claude API key (Claude Console, Getfocus account) — never commit it.
ANTHROPIC_API_KEY=
# Models (defaults shown)
# AI_MODEL=claude-sonnet-5-5
# AI_FAST_MODEL=claude-haiku-5-5
# Monthly token cap per license (input + output), unless HQ sets another
# AI_MONTHLY_TOKENS=3000000
# The portal service calls in with this token (same value in portal-service AI_SERVICE_TOKEN)
# AI_SERVICE_TOKEN=
# HQ reads usage with this token (same value in HQ AI_ADMIN_TOKEN)
# AI_ADMIN_TOKEN=
# DATABASE_URL=   (blank = embedded database in ./data)
# LICENSE_PUBLIC_KEYS=   (production: the HQ public key)
# Development without ANTHROPIC_API_KEY answers with fixed examples; AI_FAKE=0 turns that off.
# AI_FAKE=0
