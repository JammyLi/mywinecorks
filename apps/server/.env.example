# cloud = many client workspaces; selfhost = one workspace on the client's server
MODE=selfhost
PORT=3500
DATA_DIR=./data
# Public address used in setup links
PUBLIC_URL=http://localhost:5500
# Require 2-step verification for Owner/Admin roles (default: on in cloud, off in selfhost)
# REQUIRE_2FA_ADMINS=true
# Email for "Forgot password?" links (optional). Without it, an Owner/Admin creates reset links
# in Settings › Users, or run ./scripts/reset-password.sh on the server.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=MyWineCorks <no-reply@example.com>
