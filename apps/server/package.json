    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.4.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "node-forge": "^1.4.4",
    "nodemailer": "^10.6.1",
    "otpauth": "^9.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
