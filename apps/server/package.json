    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
