---
import Base from '../../../layouts/Base.astro';
import Legal from '../../../components/Legal.astro';
import { langOf, langPaths, t as tr } from '../../../i18n/index.ts';
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const t = tr(lang);
const title = { terms: t('foot.terms'), privacy: t('foot.privacy'), licence: t('foot.licence') }['terms'];
---
<Base lang={lang} path="/legal/terms/" title={title}>
  <Legal lang={lang} page="terms" />
</Base>
