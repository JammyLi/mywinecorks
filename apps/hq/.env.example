# MyWineCorks HQ (back office + license API). Copy to .env for local development.
PORT=3700
PUBLIC_URL=http://localhost:3700
# Blank = embedded PostgreSQL (PGlite) in ./data/pg. Production: a real PostgreSQL URL.
DATABASE_URL=
# First Super Admin (gets a one-time setup link on first start).
FIRST_ADMIN=jammy.li@getfocus.com
# License signing key (Ed25519, PEM). Blank in development = generated once into ./data/.
# Production: from the secret store only, never in a file in the repository.
LICENSE_SIGNING_KEY=
SMTP_URL=
MAIL_FROM=MyWineCorks <no-reply@mywinecorks.com>
