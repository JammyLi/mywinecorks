{
  "name": "@mwc/hq",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "vite build",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "publish-release": "tsx src/cli/publish-release.ts",
    "gen-signing-key": "tsx src/cli/gen-signing-key.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@mwc/license": "workspace:*",
    "@mwc/shared": "workspace:*",
    "@mwc/ui": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "nodemailer": "^6.10.1",
    "otpauth": "^9.3.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
