{
  "name": "mywinecorks",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter \"./**\" --if-present test",
    "typecheck": "pnpm --filter \"./**\" --if-present typecheck",
    "lint": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "release": "node scripts/release/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=11.1.1"
    }
  }
}
