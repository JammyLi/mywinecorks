# Cloud server settings (copy to .env; never commit .env)
MWC_VERSION=latest
PUBLIC_URL=https://app.mywinecorks.com
# Long random string; the same value goes into HQ as CLOUD_PROVISION_TOKEN
PROVISION_TOKEN=
SMTP_URL=
MAIL_FROM=MyWineCorks <no-reply@mywinecorks.com>
# S3-compatible bucket for continuous backups (AWS S3, Cloudflare R2, Backblaze B2…)
LITESTREAM_BUCKET=
LITESTREAM_REGION=ap-northeast-1
# Blank for AWS; e.g. https://<account>.r2.cloudflarestorage.com for R2
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
